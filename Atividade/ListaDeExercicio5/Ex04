#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[]) {
	int i, num[10], maior;
	
	for(i=0; i<10; i++) {
		printf("Digite o numero %d: ", i+1);
		scanf("%d", &num[i]);
	}
	maior = num[0];
	
	for(i=1; i<=10; i++) {
		maior = (maior + num[i] + abs(maior-num[i])) / 2;
	}
	
	printf("%d eh o maior", maior);
	return 0;
}
